<Window x:Class="OverlayImageForWindows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OverlayImageForWindows.Views"
        mc:Ignorable="d"
        Title="SettingsWindow" Height="250" Width="350" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Button Name="HistoryCheck" Click="HistoryCheck_Click" Width="150" Height="35" ToolTip="Открыывает файл с логами приложения и бота">Просмотр логов</Button>
        <Button Grid.Row="0" Grid.Column="1" Width="150" Height="35" Name="BotCheckButton" Click="BotCheckButton_Click" ToolTip="Отправляет сообщение пользователю с айди, указанным в поле &quot;ваш телеграм айди&quot; если он уже отправлял боту хотябы одно сообщение.">Проверка бота</Button>
        <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Name="AcceptOtherFiles" Height="25" Margin="10,0" ToolTip="Если отключено то только пользователь, чем телеграм айди указан в поле &quot;ваш телеграм айди&quot; сможет отправлять вам файлы.">Разрешить другим пользователям добавлять файлы</CheckBox>
        <Slider Name="ImageOpacity" Grid.Row="2" Grid.Column="1" Maximum="1" Minimum="0.1"></Slider>
        <TextBlock Grid.Row="2">Прозрачность изображения</TextBlock>
        
        
        <TextBlock TextAlignment="Center" VerticalAlignment="Center" Grid.Row="3" Cursor="Hand" Name="IdText">Ваш телеграм айди</TextBlock>
        <TextBox Width="150" Height="25" Name="IdInput" Grid.Row="3" Grid.Column="1"></TextBox>
        <TextBlock TextAlignment="Center" VerticalAlignment="Center" Grid.Row="5" Cursor="Hand" Name="TokenText">Токен бота</TextBlock>
        <TextBox Width="150" Height="25" Name="TokenInput" Grid.Row="5" Grid.Column="1"></TextBox>
    </Grid> 
</Window>
